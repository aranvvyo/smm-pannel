# ── Apirone crypto deposit gateway ──────────────────────────────────────────
# Account ID and Transfer Key are entered in Admin → Settings at runtime.
# They are stored in the settings table (server-side, write-only — the API
# never returns them) and NEVER appear in .env or API responses.
#
# The webhook token (optional) is also entered in Admin → Settings. Callbacks
# are additionally verified server-side via the public invoice-info endpoint
# before any credit, so a shared token is defense-in-depth only.

# ── Public base URL (for QR codes / callbacks) ──────────────────────────────
# PUBLIC_BASE_URL=http://localhost:3000

# ── SMM provider ────────────────────────────────────────────────────────────
# SMMProvider API key for the smmpost adapter (entered in Admin → Providers).
# SMM_PROVIDER_KEY=

# ── Provider API keys (entered via Admin UI, stored in DB) ──────────────────
# SMMProvider API key and URL are entered at runtime by the admin.
# They are stored in the providers table and NEVER exposed in API responses.
# SMM_KEY=           ← old name; ignore — use admin panel instead

# ── App ─────────────────────────────────────────────────────────────────────
PORT=3000
SESSION_SECRET=
# Session cookies are Secure (HTTPS only) by default. Uncomment COOKIE_SECURE=0
# ONLY for local plain-HTTP development. Never set it in production.
# COOKIE_SECURE=0
NODE_ENV=production
LOG_LEVEL=warn
# SMM_TEST=1         ← only for smoke tests; never set in production

# ── Owner admin accounts (REQUIRED — never committed to the repo) ────────────
# Admin credentials come ONLY from these environment variables (the codebase
# holds none). On Render set them in Dashboard → Environment; leave unset and
# the instance boots with no admins at all. ADMIN_EMAIL / ADMIN_PASSWORD are
# short forms of account #1.
ADMIN_EMAIL_1=
ADMIN_PASSWORD_1=
# ADMIN_EMAIL_2=
# ADMIN_PASSWORD_2=

# ── Public base URL (QR codes / Apirone webhook callbacks) ───────────────────
# In production set this to your real public URL — never localhost.
# PUBLIC_BASE_URL=https://instasmm.store

# ── VCGetaway INR gateway (PROPOSED names only — pending official API docs) ──
# The gateway publishes no verifiable API documentation yet (the site is a
# marketing page + Android APK download; the developer's GitHub repo has no
# API spec). NOTHING consumes these variables yet — there is no server code
# path, no checkout endpoint and no webhook, and the client keeps
# GATEWAY_CONNECTED=false. Do NOT set real values until the official API
# contract has been obtained and the integration is implemented and verified.
# VCGETAWAY_API_KEY=
# VCGETAWAY_API_URL=
# VCGETAWAY_WEBHOOK_SECRET=

# ── PostgreSQL (optional — omit to keep the default SQLite file) ──
# A postgres:// connection string (e.g. from the Neon dashboard;
# keep the ?sslmode=require parameter). When set, the panel runs
# against PostgreSQL instead of SQLite with identical behavior,
# and the database is initialized FRESH from server/schema.pg.sql
# (existing SQLite data is NOT migrated — admins come from the
# ADMIN_EMAIL_* vars and providers are re-added in the admin panel).
# DATABASE_URL=postgres://user:password@host:5432/neondb?sslmode=require
