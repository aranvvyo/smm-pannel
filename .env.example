# ── Apirone crypto deposit gateway ──────────────────────────────────────────
# Account ID and Transfer Key are entered in Admin → Settings at runtime.
# They are stored in the settings table (server-side, write-only — the API
# never returns them) and NEVER appear in .env or API responses.
#
# The webhook token (optional) is also entered in Admin → Settings. Callbacks
# are additionally verified server-side via the public invoice-info endpoint
# before any credit, so a shared token is defense-in-depth only.

# ── Public base URL (for QR codes / callbacks) ──────────────────────────────
# PUBLIC_BASE_URL=http://localhost:3000

# ── SMM provider ────────────────────────────────────────────────────────────
# SMMProvider API key for the smmpost adapter (entered in Admin → Providers).
# SMM_PROVIDER_KEY=

# ── Provider API keys (entered via Admin UI, stored in DB) ──────────────────
# SMMProvider API key and URL are entered at runtime by the admin.
# They are stored in the providers table and NEVER exposed in API responses.
# SMM_KEY=           ← old name; ignore — use admin panel instead

# ── App ─────────────────────────────────────────────────────────────────────
PORT=3000
SESSION_SECRET=
NODE_ENV=production
LOG_LEVEL=warn
# SMM_TEST=1         ← only for smoke tests; never set in production

# ── Owner admin accounts (REQUIRED — never committed to the repo) ────────────
# Admin credentials come ONLY from these environment variables (the codebase
# holds none). On Render set them in Dashboard → Environment; leave unset and
# the instance boots with no admins at all. ADMIN_EMAIL / ADMIN_PASSWORD are
# short forms of account #1.
ADMIN_EMAIL_1=
ADMIN_PASSWORD_1=
# ADMIN_EMAIL_2=
# ADMIN_PASSWORD_2=

# ── Public base URL (QR codes / Apirone webhook callbacks) ───────────────────
# In production set this to your real public URL — never localhost.
# PUBLIC_BASE_URL=https://instasmm.store
